---
import Layout from '../../layouts/Layout.astro';
import { components } from '../../data/components';

import Demo from '../../demos';

export function getStaticPaths() {
  return components.map((c) => ({ params: { slug: c.slug }, props: { doc: c } }));
}

const { doc } = Astro.props;
---

<Layout title={doc.name}>
  <p class="eyebrow">{doc.category}</p>
  <h1>{doc.name}</h1>
  <p class="lede">{doc.summary}</p>

  <div class="preview">
    <Demo client:load slug={doc.slug} />
  </div>

  <a class="sb-link" href={`/storybook/?path=/story/${doc.storybook}`} target="_blank" rel="noopener">
    Voir toutes les variantes et les proprietes dans le Storybook
  </a>

  <div class="guidance">
    <section class="do">
      <h2>Quand s'en servir</h2>
      <ul>{doc.when.map((t) => <li>{t}</li>)}</ul>
    </section>
    <section class="dont">
      <h2>Quand ne pas s'en servir</h2>
      <ul>{doc.avoid.map((t) => <li>{t}</li>)}</ul>
    </section>
  </div>
</Layout>

<style>
  .eyebrow {
    margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .05em;
    text-transform: uppercase; color: var(--sirius-primary);
  }
  h1 { margin: 6px 0 12px; font-size: 28px; letter-spacing: -.02em; }
  .lede { margin: 0 0 28px; font-size: 15px; color: var(--sirius-text-subdued); max-width: 62ch; }

  .preview {
    padding: 32px;
    background: var(--sirius-bg-app);
    border: 1px solid var(--sirius-border);
    border-radius: var(--sirius-radius-base);
  }

  .sb-link {
    display: inline-block; margin: 12px 0 0;
    font-size: 13px; font-weight: 500;
  }

  .guidance {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px;
  }
  @media (max-width: 700px) { .guidance { grid-template-columns: 1fr; } }
  .guidance section {
    padding: 16px 20px;
    border-radius: var(--sirius-radius-base);
    border: 1px solid var(--sirius-border);
  }
  .do { background: var(--sirius-success-surface); border-color: var(--sirius-success-border); }
  .dont { background: var(--sirius-critical-surface); border-color: var(--sirius-critical-border); }
  .guidance h2 { margin: 0 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; }
  .do h2 { color: var(--sirius-success); }
  .dont h2 { color: var(--sirius-critical); }
  .guidance ul { margin: 0; padding-left: 18px; }
  .guidance li { font-size: 13px; margin-bottom: 6px; }
</style>
