{
  "name": "@kuroitamashi/sirius-ui",
  "version": "1.0.7",
  "description": "Modern, high-performance Design System built with React and TypeScript.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./src/styles.css",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./Icon": {
      "types": "./src/Icon/Icon.tsx",
      "import": "./src/Icon/Icon.tsx",
      "default": "./src/Icon/Icon.tsx"
    },
    "./Button": {
      "types": "./src/Button/index.ts",
      "import": "./src/Button/index.ts",
      "default": "./src/Button/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.6.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroitamashi/sirius-ui.git"
  },
  "keywords": [
    "design-system",
    "react",
    "ui",
    "components",
    "sirius",
    "typescript"
  ],
  "author": "Kuroitamashi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kuroitamashi/sirius-ui/issues"
  },
  "homepage": "https://github.com/kuroitamashi/sirius-ui#readme",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm run build-storybook && npm --prefix docs-site run build",
    "check:icons": "node src/Icon/check-icons.mjs"
  },
  "dependencies": {
    "@shopify/polaris-icons": "^9.3.1"
  }
}
